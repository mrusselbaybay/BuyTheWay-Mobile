<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only: allow plain-HTTP calls to the Laravel dev server
         on the LAN (e.g. http://192.168.x.x:8000/api). Android 9+ blocks
         cleartext traffic by default; release builds keep that protection
         since this override lives in the debug source set. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
